# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Local Telegram Bot API Server (optional, for files > 20MB)
# To support large file uploads (up to 2GB), run a local Bot API server.
# See docker-compose.yml for setup. Get API credentials from https://my.telegram.org/auth
# TELEGRAM_API_SERVER=http://localhost:8081
# TELEGRAM_API_ID=your_api_id
# TELEGRAM_API_HASH=your_api_hash
# TELEGRAM_LOCAL_FILES_PATH=/path/to/data/telegram-bot-api  # Host path matching docker-compose volume

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Transcriber Settings (gemini-2.5-flash)
TRANSCRIBER_MODEL=gemini-2.5-flash
TRANSCRIBER_TEMPERATURE=1.0
TRANSCRIBER_THINKING_LEVEL=low

# Editor Settings (gemini-2.5-pro)
EDITOR_MODEL=gemini-2.5-pro
EDITOR_TEMPERATURE=1.0
EDITOR_THINKING_LEVEL=high

# Application Settings
TEMP_DIR=/tmp/omni_transcriber
LOG_LEVEL=INFO

# Rclone Upload (optional)
# If set, transcripts will be uploaded to this path after completion
# Only chat IDs in RCLONE_ENABLED_CHAT_IDS will have this feature
RCLONE_UPLOAD_PATH=dropbox:/Obsidian/Transcripts
RCLONE_ENABLED_CHAT_IDS=123456789

# RSSHub Configuration (required for Xiaoyuzhou podcast support)
# Set this to your RSSHub instance URL to enable Xiaoyuzhou podcast transcription
RSSHUB_BASE_URL=https://your-rsshub-instance.com
RSSHUB_KEY=your_optional_access_key
